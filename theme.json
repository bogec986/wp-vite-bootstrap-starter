{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "spacing": {
      "blockGap": true,
      "spacingSizes": [
        {
          "name": "Extra small",
          "size": "0.5rem",
          "slug": "xs"
        },
        {
          "name": "Small",
          "size": "1rem",
          "slug": "sm"
        },
        {
          "name": "Medium",
          "size": "1.5rem",
          "slug": "md"
        },
        {
          "name": "Large",
          "size": "2rem",
          "slug": "lg"
        },
        {
          "name": "Extra large",
          "size": "3rem",
          "slug": "xl"
        }
      ],
      "units": ["px", "em", "rem", "%", "vw"]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Roboto, sans-serif",
          "name": "Roboto",
          "slug": "roboto"
        },
        {
          "fontFamily": "\"Roboto Condensed\", sans-serif",
          "name": "Roboto Condensed",
          "slug": "roboto-condensed"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "name": "Extra large",
          "size": "2rem",
          "slug": "x-large"
        }
      ],
      "lineHeight": true,
      "fontWeight": true
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--roboto)",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--roboto-condensed)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      }
    }
  }
}
